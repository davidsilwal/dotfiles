# =============================================================================
#  tmux.service — keeps a tmux server alive on the VPS
#
#  A tmux server started over SSH dies with the SSH session unless the user
#  manager keeps running. This unit starts a detached session at boot, so
#  tmux-continuum can restore the previous session after a reboot, and
#  `systemctl --user stop tmux` tears the server down cleanly.
#
#  Enable with:
#      systemctl --user daemon-reload
#      systemctl --user enable --now tmux.service
# =============================================================================

[Unit]
Description=tmux session server
Documentation=man:tmux(1)
After=network-online.target
PartOf=default.target

[Service]
Type=oneshot
RemainAfterExit=yes

# Start a detached session only when the server is not already running, so
# the unit is safe to restart.
ExecStart=/bin/sh -c '/usr/local/bin/tmux has-session -t default 2>/dev/null || /usr/local/bin/tmux new-session -d -s default'

# Stopping the unit is an explicit request to tear the server down.
ExecStop=/usr/local/bin/tmux kill-server

[Install]
WantedBy=default.target
