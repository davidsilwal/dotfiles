# ─────────────────────────────────────────────
#  Basic settings
# ─────────────────────────────────────────────

set shell sh
set shellopts '-eu'
set ifs "\n"
set scrolloff 10
set icons true
set period 1
set hidden

# ─────────────────────────────────────────────
#  Preview
# ─────────────────────────────────────────────

set previewer ctpv
set cleaner ctpvclear
&ctpv -s $id

cmd on-quit &ctpvquit $id

# ─────────────────────────────────────────────
#  Commands
# ─────────────────────────────────────────────

# GUI openers are optional: the first one that exists on this host wins, and a
# missing one falls back to editing the file instead of failing silently.
cmd open &{{
    mime=$(file --mime-type -Lb "$f")
    case $mime in
        text/*) opener= ;;
        image/*) opener=imv ;;
        audio/*|video/*) opener=mpv ;;
        application/pdf) opener=zathura ;;
        *) opener=xdg-open ;;
    esac
    if [ -n "$opener" ] && command -v "$opener" >/dev/null 2>&1; then
        "$opener" "$f"
    else
        lf -remote "send $id \$nvim $f"
    fi
}}

cmd trash %trash-put $fx

cmd extract %{{
    case $f in
        *.zip) unzip $f;;
        *.tar.gz) tar xzf $f;;
        *.tar.bz2) tar xjf $f;;
        *.tar.xz) tar xJf $f;;
        *.rar) unrar x $f;;
        *.7z) 7z x $f;;
    esac
}}

cmd copyto %{{
    dest=$(find ~ -type d | fzf)
    [ -n "$dest" ] && cp -r $fx "$dest"
}}

cmd moveto %{{
    dest=$(find ~ -type d | fzf)
    [ -n "$dest" ] && mv $fx "$dest"
}}

cmd mkdir %{{
    printf "Directory name: "
    read ans
    mkdir -p "$ans"
}}

cmd mkfile %{{
    printf "File name: "
    read ans
    touch "$ans"
}}

# ─────────────────────────────────────────────
#  Keybindings
# ─────────────────────────────────────────────

# Clear conflicting defaults
map d

# lf 38+ds ships a default binding for <c-space> whose command does not exist in
# this build, so it logs "unknown mapping: <c-space>" on every start. Binding
# the key explicitly removes the message and gives it the useful job.
map <c-space> :set preview!

# File operations
map D trash
map <delete> trash
map E extract
map C copyto
map M moveto
map A mkdir
map T mkfile

# Navigation
map g/ cd /
map gh cd ~
map gc cd ~/.config
map gd cd ~/Downloads
map gv cd ~/Videos
map gp cd ~/Pictures

# Open in nvim explicitly
map V push :$nvim<space>
