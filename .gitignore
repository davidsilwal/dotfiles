# =============================================================================
#  dotfiles .gitignore
#
#  This repository is checked out with $HOME as its work tree, so the ignore
#  rules have to cover everything that lands in a home directory. Without
#  them a plain `dotfiles add .` would try to commit the repository into
#  itself, ~2 GB of tool state, and live credentials.
# =============================================================================

# --- The repository itself ---------------------------------------------------
# The bare repo lives at ~/.dotfiles, which is *inside* its own work tree.
# Without this rule `dotfiles add .` commits the repository into itself.
.dotfiles/

# --- Installed plugins and tool state ----------------------------------------
# These are fetched or generated by their own managers, never committed.
.config/tmux/plugins/
.tmux/
.tmux/plugins/
# zsh plugins are cloned by setup.sh, not part of the baseline
.config/zsh/plugins/
.local/share/nvim/
.local/share/opencode/
.local/share/opentui/
.local/share/pi-node/
.local/state/
.cache/
.cargo/
.rustup/
.npm/
.nvm/
.vim/
.viminfo

# Go toolchain state. The module cache is ~275 MB of downloaded source and
# is owned by the go command, never by the configuration.
go/pkg/
go/bin/

# Backups and working copies of the nvim configuration. setup.sh writes
# these when it swaps a configuration in or out; the live tree is the
# submodule at .config/nvim.
.config/nvim.bak.*
.config/nvim.mine/

# Everything under .local/share is runtime state (tmux-continuum session
# dumps, zoxide's database, lf history, man pages) - except the tracked
# helper scripts in .local/share/bin.
.local/share/*
!.local/share/bin/

# Downloaded binaries. The bat/fd symlinks beside them ARE tracked.
.local/bin/zoxide

# --- Credentials: never commit these ----------------------------------------
# Live tokens, device keys and host fingerprints.
.config/gh/
.config/github-copilot/
.config/opencode/
.pi/
.opencode/
.config/manicode/
.ssh/
*.auth.json
hosts.yml
authorized_keys
known_hosts

# --- Tool telemetry and caches -----------------------------------------------
.config/go/
.config/fontconfig/

# --- Runtime noise -----------------------------------------------------------
.bash_history
.tmux.conf.bak.*
.wget-hsts
.zcompdump*
.DS_Store

# --- Scratch space used by other tooling -------------------------------------
workspace/

# Rollback archives written by setup.sh and cleanup runs (tens of MB).
backups/
